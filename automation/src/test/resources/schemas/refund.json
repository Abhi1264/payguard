{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "orderId", "userId", "amount", "currency", "status", "providerTransactionId", "authorizedAt", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "orderId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "userId": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "amount": { "type": "number" },
    "currency": { "type": "string", "enum": ["USD", "EUR", "GBP"] },
    "status": { "type": "string", "enum": ["REFUNDED"] },
    "providerTransactionId": { "type": "string", "minLength": 1 },
    "authorizedAt": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
